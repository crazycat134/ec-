# ========== DeepSeek API（可选，默认关闭） ==========
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# ========== 本地服务 ==========
APP_HOST=127.0.0.1
APP_PORT=8765
# 允许跨域调用本地 API 的来源，以逗号分隔。需要 Automa 时，将其扩展来源加入列表。
# 示例：APP_ALLOWED_ORIGINS=http://127.0.0.1:8765,http://localhost:8765,chrome-extension://你的Automa扩展ID
APP_ALLOWED_ORIGINS=http://127.0.0.1:8765,http://localhost:8765
