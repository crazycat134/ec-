-item\"]');\n    if (firstDraft) break;\n    await sleep(200);\n  }\n\n  if (!firstDraft) {\n    console.log('NO_MORE_DRAFTS');\n    sessionStorage.removeItem('delCount');\n    return;\n  }\n\n  // 计数 +1，在跳转之前\n  sessionStorage.setItem('delCount', String(count + 1));\n  console.log(`第 ${count + 1} 次删除，草稿 ID:`, firstDraft.href);\n\n  location.href = firstDraft.href;\n})();","context":"website","description":"","disableBlock":false,"everyNewTab":false,"preloadScripts":[],"runBeforeLoad":false,"timeout":20000},"label":"javascript-code"},{"id":"6stmwir","type":"BlockBasic","initialized":false,"position":{"x":2279.9809633464906,"y":162.43778975213112},"data":{"code":"(async () => {\n  const sleep = (ms) => new Promise(r => setTimeout(r, ms));\n\n  let deleteBtn = null;\n  for (let k = 0; k < 60; k++) {\n    deleteBtn = document.querySelector('[data-testid=\"delete-draft\"] button');\n    if (deleteBtn) break;\n    await sleep(200);\n  }\n  if (!deleteBtn) { console.error('找不到删除按钮'); return; }\n\n  deleteBtn.click();\n  await sleep(800);\n\n  const confirmBtn = Array.from(document.querySelectorAll('button'))\n    .find(b => (b.textContent || '').trim() === '削除する');\n  if (!confirmBtn) { console.error('找不到确认按钮'); return; }\n\n  confirmBtn.click();\n  await sleep(2000);\n\n  location.href = 'https://jp.mercari.com/mypage/drafts';\n})();","context":"website","description":"","disableBlock":false,"everyNewTab":false,"preloadScripts":[],"runBeforeLoad":false,"timeout":20000},"label":"javascript-code"},{"id":"tfe4twk","type":"BlockBasic","initialized":false,"position":{"x":1510.8663673247509,"y":7.962156604907684},"data":{"disableBlock":false,"loopId":"vNgXiC","maxLoop":0,"toNumber":10,"fromNumber":0,"startIndex":0,"loopData":"[]","description":"","variableName":"","referenceKey":"","reverseLoop":false,"elementSelector":"","waitForSelector":false,"waitSelectorTimeout":5000,"resumeLastWorkflow":false,"loopThrough":"numbers","settings":{"blockTimeout":0,"debugMode":false}},"label