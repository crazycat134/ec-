"BlockDelay","initialized":false,"position":{"x":422.50230162311766,"y":422.1657793873941},"data":{"disableBlock":false,"time":"1000"},"label":"delay"},{"id":"m0ep5u6","type":"BlockBasic","initialized":false,"position":{"x":454.1261380852402,"y":313.9127872621066},"data":{"description":"","disableBlock":true,"findBy":"cssSelector","markEl":false,"multiple":false,"selector":".inputContainer__ae1855b0 > [type=\"checkbox\"]","waitForSelector":false,"waitSelectorTimeout":5000},"label":"event-click"},{"id":"gxts4jk","type":"BlockDelay","initialized":false,"position":{"x":428.3818595513028,"y":149.73938081257484},"data":{"disableBlock":false,"time":"2000"},"label":"delay"},{"id":"3f69889","type":"BlockBasic","initialized":false,"position":{"x":441.4012789238641,"y":564.9181157978724},"data":{"code":"// 等待元素出现的辅助函数\nfunction waitForElement(selector, timeout = 10000) {\n    return new Promise((resolve, reject) => {\n        const start = Date.now();\n        const timer = setInterval(() => {\n            const el = document.querySelector(selector);\n            if (el) {\n                clearInterval(timer);\n                resolve(el);\n            } else if (Date.now() - start > timeout) {\n                clearInterval(timer);\n                reject(new Error('等待元素超时: ' + selector));\n            }\n        }, 200);\n    });\n}\n\n// 设置 React 输入框的值\nfunction setReactInputValue(element, value) {\n    if (!element) return false;\n    const proto = element.tagName === 'TEXTAREA'\n        ? window.HTMLTextAreaElement.prototype\n        : window.HTMLInputElement.prototype;\n    const setter = Object.getOwnPropertyDescriptor(proto, \"value\").set;\n    setter.call(element, value);\n    element.dispatchEvent(new Event('input', { bubbles: true }));\n    element.dispatchEvent(new Event('change', { bubbles: true }));\n    // 额外触发一次 React 常用的事件\n    element.dispatchEvent(new Event('blur', { bubbles: true }));\n    return true;\n}\n\n(async () => {\n    try {\n        console.log('=== 开始填写商品信息 ===');\n\n        // 1. 获取 Automa 变量\n        const products = automaRefData('variables', 'products');\n        const currentIndex = automaRefData('loopData', 'item.$index');\n        console.log('products 长度:', products ? products.length : 'null');\n        console.log('currentIndex:', currentIndex);\n\n        const currentProduct = products && products[currentIndex];\n        if (!currentProduct) {\n            console.error('未找到当前商品数据，currentProduct 为空');\n            return;\n        }\n        console.log('当前商品:', currentProduct.title);\n\n        // 2. 等待输入框出现\n        const titleInput = await waitForElement('input[name=\"name\"]');\n        const descInput = await waitForElement('textarea[name=\"description\"]');\n        const priceInput = await waitForElement('input[name=\"price\"]');\n        console.log('输入框已找到');\n\n        // 3. 填写\n        const ok1 = setReactInputValue(titleInput, currentProduct.title);\n        const ok2 = setReactInputValue(descInput, currentProduct.description);\n        const ok3 = setReactInputValue(priceInput, currentProduct.price);\n\n        console.log('填写结果: 标题=', ok1, '描述=', ok2, '价格=', ok3);\n\n        // 4. 额外：如果标题没填上，尝试用 execCommand 方式\n        if (titleInput.value !== currentProduct.title) {\n            console.warn('标题值不一致，尝试 execCommand 方式');\n            titleInput.focus();\n            titleInput.select();\n            document.execCommand('insertText', false, currentProduct.title);\n        }\n\n        console.log('=== 填写完成 ===');\n    } catch (e) {\n        console.error('执行出错:', e.message);\n    }\n})();","context":"website","description":"","disableBlock":false,"everyNewTab":false,"preloadScripts":[],"runBeforeLoad":false,"timeout":20000},"label":"javascript-code"},{"id":"l94iemq","type":"BlockBasic","initialized":false,"position":{"x":1671.4379885041706,"y":865.6516255057751},"data":{"code":"// 1. 获取当前商品数据\nconst products = automaRefData('variables', 'products');\nconst currentIndex = automaRefData('loopData', 'item.$index');\nconst categories = products[currentIndex].categories; // 例如 [\"本・雑誌・漫画\", \"漫画\", \"少年漫画\"]\n\n// 2. 获取要点击的第一级分类文字\nconst targetText = categories[0]; // \"本・雑誌・漫画\"\n\n// 3. 精准查找包含该文字的按钮或链接（去除空格）\nconst elements = Array.from(document.querySelectorAll('a, button, div[role=\"button\"], li, div'));\nconst target = elements.find(el => el.textContent.trim() === targetText);\n\nif (target) {\n    target.click();\n    console.log('已点击第一级分类:', targetText);\n} else {\n    console.error('未找到第一级分类:', targetText);\n}","context":"website","description":"","disableBlock":false,"everyNewTab":false,"preloadScripts":[],"runBeforeLoad":false,"timeout":20000},"label":"javascript-code"},{"id":"6jrqt3p","type":"BlockBasic","initialized":false,"position":{"x":1992.3142747975414,"y":802.5145420740059},"data":{"code":"const products = automaRefData('variables', 'products');\nconst currentIndex = automaRefData('loopData', 'item.$index');\nconst categories = products[currentIndex].categories;\n\nconst targetText = categories[1]; // \"漫画\"\n\nconst elements = Array.from(document.querySelectorAll('a, button, div[role=\"button\"], li, div'));\nconst target = elements.find(el => el.textContent.trim() === targetText);\n\nif (target) {\n    target.click();\n    console.log('已点击第二级分类:', targetText);\n} else {\n    console.error('未找到第二级分类:', targetText);\n}","context":"website","description":"","disableBlock":false,"everyNewTab":false,"preloadScripts":[],"runBeforeLoad":false,"timeout":20000},"label":"javascript-code"},{"id":"unmwiru","type":"BlockBasic","initialized":false,"position":{"x":2195.702051373306,"y":958.03662950556},"data":{"code":"const products = automaRefData('variables', 'products');\nconst currentIndex = automaRefData('loopData', 'item.$index');\nconst categories = products[currentIndex].categories;\n\nconst targetText = categories[2]; // \"少年漫画\"\n\nconst elements = Array.from(document.querySelectorAll('a, button, div[role=\"button\"], li, div'));